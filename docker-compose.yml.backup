version: '3.8'

services:
  postgres:
    image: postgres:15-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: password
      POSTGRES_DB: deribit_db
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./init.sql:/docker-entrypoint-initdb.d/init.sql

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"

  app:
    build: .
    ports:
      - "8000:8000"
    depends_on:
      - postgres
      - redis
    environment:
      DATABASE_URL: postgresql+psycopg://postgres:password@postgres:5432/deribit_db
      REDIS_URL: redis://redis:6379/0
    volumes:
      - .:/app
    command: uvicorn src.main:app --host 0.0.0.0 --port 8000 --reload

  celery-worker:
    build: .
    depends_on:
      - postgres
      - redis
    environment:
      DATABASE_URL: postgresql+psycopg://postgres:password@postgres:5432/deribit_db
      REDIS_URL: redis://redis:6379/0
    volumes:
      - .:/app
    command: celery -A src.tasks.price_fetcher.app worker --loglevel=info

  celery-beat:
    build: .
    depends_on:
      - postgres
      - redis
    environment:
      DATABASE_URL: postgresql+psycopg://postgres:password@postgres:5432/deribit_db
      REDIS_URL: redis://redis:6379/0
    volumes:
      - .:/app
    command: celery -A src.tasks.price_fetcher.app beat --loglevel=info

volumes:
  postgres_data: